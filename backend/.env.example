# Backend Environment Variables
# NOTE: Port 5000 conflicts with macOS AirPlay. Using 3001 instead.
PORT=3001
DB_NAME=restaurant_db
DB_USER=user
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# Security
JWT_SECRET=supersecretkey123
# ⚠️ IMPORTANT: Change this in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Environment
NODE_ENV=development

# Optional: Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Prenotazioni
# HMAC dei numeri di telefono per il flag no-show (genera come JWT_SECRET, non cambiarlo dopo il go-live)
PHONE_HASH_SECRET=change-me
# Twilio WhatsApp: se assenti, le notifiche vanno in dry-run (solo log)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# URL pubblico (verifica firma webhook Twilio)
PUBLIC_BASE_URL=http://localhost:3001
